---
import Mail from "@lucide/astro/icons/mail";
import config from "@/config";
import EmailLink from "../EmailLink.astro";
---

<p class="flex items-center gap-2">
  {config.site.email && (
    <EmailLink email={config.site.email} class="flex items-center gap-2">
      <Mail />
    </EmailLink>
  )}
</p>
